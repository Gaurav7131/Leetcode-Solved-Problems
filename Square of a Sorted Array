class Solution {
    public int[] sortedSquares(int[] nums) {

        int n=nums.length;
        int[] result= new int[n]; //final row

        int left=0; //first array ptr
        int right=n-1;//last array pointer n-1

        // we have to start from max no(array)
        for(int i=n-1;i>=0;i--){
            int squareLeft=nums[left]*nums[left];
            int squareRight=nums[right]*nums[right];

            // if no has max sq  placed  at the end of the arrow(row)
            if(squareLeft>squareRight){
                result[i]=squareLeft;
                left++;
            }
            else{
                result[i]=squareRight;
                right--;
            }
        }
            return result;
        }

    }
